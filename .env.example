# Kopieren nach .env (cp .env.example .env). Wird nur von `npm run start:lan` gelesen.
# Auf Railway stehen dieselben Namen unter "Variables".

# Port im LAN-Modus (Standard: 3000)
PORT=3000

# Geheimer Schlüssel für Login-Sitzungen. Leer lassen = wird beim ersten Start zufällig erzeugt
# und im Datenordner gespeichert (kein im Code sichtbarer Standardwert mehr).
# SESSION_SECRET=

# Erster Admin beim allerersten Start (leere Datenbank). Ohne Angabe wird ein Zufallspasswort im
# Startprotokoll angezeigt. Das Passwort muss beim ersten Login geändert werden.
# INITIAL_ADMIN_NAME=Lio
# INITIAL_ADMIN_PASSWORD=

# Speicherorte. Leer lassen = ./data und ./uploads im Projektordner.
# Auf Railway ZWINGEND auf ein Volume zeigen lassen (Mount /data):  DATA_DIR=/data  UPLOADS_DIR=/data/uploads
# DATA_DIR=./data
# UPLOADS_DIR=./uploads

# Wöchentliches Backup per E-Mail (optional). Sendet Datenbank + Fotos (bis ca. 18 MB, sonst nur die Datenbank).
# BACKUP_EMAIL_TO=du@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=belege@example.com
