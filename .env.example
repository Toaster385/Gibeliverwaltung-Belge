# Kopieren nach .env (cp .env.example .env). Wird nur von `npm run start:lan` gelesen.

# Port im LAN-Modus (Standard: 3000)
PORT=3000

# Geheimer Schlüssel für Login-Sessions – eigenen langen Zufallswert eintragen.
# Auf Railway ist der Wert getrennt; lokale Sessions sind ohnehin unabhängig davon.
SESSION_SECRET=bitte-aendern

# Optional: Speicherorte. Leer lassen = ./data und ./uploads im Projektordner.
# NICHT die Railway-Volume-Pfade übernehmen.
# DATA_DIR=./data
# UPLOADS_DIR=./uploads
